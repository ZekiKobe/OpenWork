{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand --forceExit",
    "db:create": "node scripts/db-create.js",
    "db:drop": "node scripts/db-drop.js",
    "db:reset": "npm run db:drop && npm run db:create",
    "db:shell": "node scripts/db-shell.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:generate": "sequelize-cli migration:generate --name",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "migrate:status": "sequelize-cli db:migrate:status",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo",
    "seed:undo:all": "sequelize-cli db:seed:undo:all",
    "db:setup": "npm run db:create && npm run migrate && npm run seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.16.0",
    "nodemailer": "^9.0.3",
    "react-hot-toast": "^2.6.0",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^8.0.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
