# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=OpenWork_db
DB_USER=root
DB_PASSWORD=password

# JWT Configuration (use a long random secret in production)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRE=15m

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (SMTP) — required for verification & password reset in production
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@openwork.com

# Stripe payments (leave empty to keep wallet deposits disabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false

# File storage: local | s3
STORAGE_DRIVER=local
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_BASE_URL=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
